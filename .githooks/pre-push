#!/usr/bin/env bash
# Refuses a push whose tip commit has a generated file out of date with its inputs (design-ensure-up-to-date), or a
# link of the decision log or the reviews on a line from main that is not pinned to a commit (design-links-check's
# `unpinned`; a hook cannot change what it pushes, so it only refuses).
# Each pushed tip is checked in its own temporary worktree, so uncommitted edits neither hide nor fake staleness.
set -euo pipefail
ROOT=$(git rev-parse --show-toplevel)
# git exports these to a hook (GIT_DIR in a linked worktree, GIT_CONFIG_PARAMETERS for git -c); passed on, the tools'
# git commands would run against this repository (rewriting its config), and the tools and DVC would read this
# checkout instead of the temporary tree
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX GIT_CONFIG_PARAMETERS
TOOLS="$ROOT/tools"
tmp=
cleanup() {   # the current temporary worktree, whatever stopped the hook
  [ -n "$tmp" ] || return 0
  # not removed (never added, or half removed): drop the directory, then prune its registration if any
  git -C "$ROOT" worktree remove --force "$tmp/tree" 2>/dev/null || { rm -rf "$tmp"; git -C "$ROOT" worktree prune || true; }
  rm -rf "$tmp"
  tmp=
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = 0000000000000000000000000000000000000000 ] && continue   # a branch deletion
  tmp=$(mktemp -d /tmp/ensure-up-to-date-push.XXXXXX)
  if ! git -C "$ROOT" worktree add -q --detach "$tmp/tree" "$local_sha"; then
    echo "push refused: $local_ref ($local_sha) cannot be checked out to check it" >&2
    status=1
  else
    if ! (cd "$ROOT" && uv run --project tools design-ensure-up-to-date --root "$tmp/tree"); then
      echo "push refused: $local_ref ($local_sha) is not up to date" >&2
      status=1
    fi
    # the links check's other problems are just build's; only the unpinned ones refuse the push here
    # (exit 0 or 1 is a verdict; anything else means the check could not run, and the push is refused)
    unpinned=
    if [ -d "$TOOLS" ] && [ -d "$tmp/tree/docs" ]; then
      links=0
      out=$( (cd "$ROOT" && uv run --project tools design-links-check "$tmp/tree/docs") 2>&1) || links=$?
      if [ "$links" -gt 1 ]; then
        echo "$out" >&2
        echo "push refused: $local_ref ($local_sha): the link check could not run (exit $links)" >&2
        status=1
      fi
      unpinned=$(printf '%s\n' "$out" | grep ': unpinned: ' || true)
    fi
    if [ -n "$unpinned" ]; then
      echo "$unpinned" >&2
      echo "push refused: $local_ref ($local_sha) has unpinned links from main: run just pin-links, commit, push again" >&2
      status=1
    fi
  fi
  cleanup
done
exit $status
